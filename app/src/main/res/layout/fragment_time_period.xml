<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Fragment"
    android:background="@color/categoryScreenBackground"
    tools:context="ui.timePeriod.TimePeriodFragment">

    <LinearLayout
        android:id="@+id/periodInfoPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margin_double"
        android:paddingTop="@dimen/margin_double"
        android:paddingEnd="@dimen/margin_double"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/selectedModeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/selectedModeLabelTextView"
                style="@style/ReportPrimaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_view_time_period_selected_mode" />

            <TextView
                android:id="@+id/selectedModeTextView"
                style="@style/ReportPrimaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_normal"
                android:textStyle="bold"
                tools:text="@string/text_on_button_time_period_last_30_days" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selectedDatesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_double"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descriptionStartPeriod"
                    style="@style/ReportSecondaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_view_period_start" />

                <TextView
                    android:id="@+id/selectStartPeriodTextView"
                    style="@style/ReportPrimaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_half_normal"
                    tools:text="01 July 2026" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_double"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/descriptionEndPeriod"
                    style="@style/ReportSecondaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_view_period_end" />

                <TextView
                    android:id="@+id/selectEndPeriodTextView"
                    style="@style/ReportPrimaryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_half_normal"
                    tools:text="31 August 2026" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margin_normal"
        android:paddingEnd="@dimen/margin_normal"
        android:paddingBottom="@dimen/margin_normal"
        app:layout_constraintBottom_toTopOf="@id/submitButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/periodInfoPanel">

        <LinearLayout
            android:id="@+id/periodButtonsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/customPeriodButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_double"
                android:text="@string/text_on_button_time_period_custom" />

            <Button
                android:id="@+id/allTimeButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_all_time" />

            <Button
                android:id="@+id/thisWeekButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_this_week" />

            <Button
                android:id="@+id/lastWeekButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_week" />

            <Button
                android:id="@+id/thisMonthButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_this_month" />

            <Button
                android:id="@+id/lastMonthButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_month" />

            <Button
                android:id="@+id/last28DaysButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_28_days" />

            <Button
                android:id="@+id/last30DaysButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_30_days" />

            <Button
                android:id="@+id/last90DaysButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_90_days" />

            <Button
                android:id="@+id/last180DaysButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_180_days" />

            <Button
                android:id="@+id/last365DaysButton"
                style="@style/TopButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/text_on_button_time_period_last_365_days" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/submitButton"
        style="@style/ButtonFullWidth"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_on_button_submit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
