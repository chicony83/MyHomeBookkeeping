<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/margin_double"
    android:paddingTop="@dimen/margin_normal"
    android:paddingEnd="@dimen/margin_double"
    android:paddingBottom="@dimen/margin_normal">

    <ImageView
        android:id="@+id/categoryIconImageView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/categoryNameTextView"
        tools:src="@drawable/category_house"
        tools:background="@color/colorPrimary" />

    <TextView
        android:id="@+id/categoryNameTextView"
        style="@style/ReportPrimaryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_normal"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintEnd_toStartOf="@id/percentTextView"
        app:layout_constraintStart_toEndOf="@id/categoryIconImageView"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Groceries" />

    <TextView
        android:id="@+id/percentTextView"
        style="@style/ReportHelperText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_normal"
        app:layout_constraintBaseline_toBaselineOf="@id/categoryNameTextView"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="29.7 %" />

    <TextView
        android:id="@+id/amountTextView"
        style="@style/ReportSecondaryText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_quarter_of_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/categoryNameTextView"
        app:layout_constraintTop_toBottomOf="@id/categoryNameTextView"
        tools:text="845.20 zl" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="7dp"
        android:layout_marginTop="@dimen/margin_half_normal"
        android:max="100"
        android:progressBackgroundTint="@color/buttonDisabledBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/categoryNameTextView"
        app:layout_constraintTop_toBottomOf="@id/amountTextView"
        tools:progress="62" />
</androidx.constraintlayout.widget.ConstraintLayout>
