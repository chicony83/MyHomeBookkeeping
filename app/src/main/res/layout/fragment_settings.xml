<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Fragment.paddingBottom"
    android:background="@color/categoryScreenBackground"
    tools:context=".ui.settings.SettingsFragment">

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="@dimen/margin_half_normal"
        android:paddingBottom="@dimen/margin_half_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/settingsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/quickPaymentBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/quickPaymentSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/quick_payment_settings_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/defaultCurrencyRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_default_currency" />

                    <TextView
                        android:id="@+id/defaultCurrencyValue"
                        style="@style/SettingsValueText"
                        android:text="@string/quick_payment_default_currency" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/defaultCashAccountRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_default_cash_account" />

                    <TextView
                        android:id="@+id/defaultCashAccountValue"
                        style="@style/SettingsValueText"
                        android:text="@string/quick_payment_default_cash_account" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/currencySelectionModeRow"
                    style="@style/SettingsValueRow"
                    android:layout_marginTop="@dimen/margin_half_normal">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_currency_selection_mode" />

                    <TextView
                        android:id="@+id/currencySelectionModeValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cashAccountSelectionModeRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_cash_account_selection_mode" />

                    <TextView
                        android:id="@+id/cashAccountSelectionModeValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/calculatorRow"
                    style="@style/SettingsToggleRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_show_calculator" />

                    <CheckBox
                        android:id="@+id/calculatorCheckBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/quick_payment_show_calculator" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/amountInputModeRow"
                    style="@style/SettingsValueRow"
                    android:layout_marginTop="@dimen/margin_half_normal">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/quick_payment_amount_input" />

                    <TextView
                        android:id="@+id/amountInputModeValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/amountScrollDigitsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/amountWholeDigitsRow"
                        style="@style/SettingsValueRow">

                        <TextView
                            style="@style/SettingsValueLabel"
                            android:text="@string/quick_payment_amount_whole_digits" />

                    <TextView
                        android:id="@+id/amountWholeDigitsValue"
                        style="@style/SettingsNumericValueText" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/amountFractionDigitsRow"
                        style="@style/SettingsValueRow">

                        <TextView
                            style="@style/SettingsValueLabel"
                            android:text="@string/quick_payment_amount_fraction_digits" />

                    <TextView
                        android:id="@+id/amountFractionDigitsValue"
                        style="@style/SettingsNumericValueText" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quickAccessBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/quickAccessSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/quick_access_settings_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/quickAccessButtonsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/applicationBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/applicationSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/settings_application_section_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/appLanguageRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_app_language_title" />

                    <TextView
                        android:id="@+id/appLanguageValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/categoriesBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/categoriesSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/settings_categories_section_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/changeCategoryOrderRow"
                    style="@style/SettingsValueLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/settings_categories_change_order" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/margin_half_normal">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_categories_display_mode" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/categoriesDisplayModeToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_half_normal"
                        app:checkedButton="@id/categoriesGridModeButton"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/categoriesListModeButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/settings_categories_display_list"
                            app:icon="@drawable/ic_view_list"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/categoriesGridModeButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="@string/settings_categories_display_grid"
                            app:icon="@drawable/ic_grid_view"
                            app:iconGravity="textStart" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/categoryUsageCountRow"
                    style="@style/SettingsToggleRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_categories_show_usage_count" />

                    <CheckBox
                        android:id="@+id/categoryUsageCountCheckBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings_categories_show_usage_count" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:id="@+id/recentCategoriesSettingsCard"
                    style="@style/SettingsCategoryPanelContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/recentCategoriesSettingsHeader"
                        style="@style/SettingsCategoryPanelHeader">

                        <TextView
                            style="@style/SettingsCategoryPanelTitle"
                            android:text="@string/settings_recent_categories_panel_enabled"
                            android:textAlignment="viewStart" />

                        <ImageView
                            android:id="@+id/recentCategoriesSettingsExpandIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand_add"
                            app:tint="@color/categoryTextSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recentCategoriesSettingsContent"
                        style="@style/SettingsCategoryPanelContent"
                        android:visibility="gone">

                        <View style="@style/SettingsCategoryPanelDivider" />

                        <LinearLayout
                            android:id="@+id/recentCategoriesPanelRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_categories_panel_visible" />

                            <CheckBox
                                android:id="@+id/recentCategoriesPanelCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_categories_panel_visible" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recentCategoriesLimitRow"
                            style="@style/SettingsValueRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_recent_categories_limit" />

                            <TextView
                                android:id="@+id/recentCategoriesLimitValue"
                                style="@style/SettingsNumericValueText" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recentCategoriesPanelTitleRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_recent_categories_panel_show_title" />

                            <CheckBox
                                android:id="@+id/recentCategoriesPanelTitleCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_recent_categories_panel_show_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/recentCategoriesLabelsRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_recent_categories_show_labels" />

                            <CheckBox
                                android:id="@+id/recentCategoriesLabelsCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_recent_categories_show_labels" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/SettingsCategoryPanelsDivider" />

                <LinearLayout
                    android:id="@+id/frequentCategoriesSettingsCard"
                    style="@style/SettingsCategoryPanelContainer">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/frequentCategoriesSettingsHeader"
                        style="@style/SettingsCategoryPanelHeader">

                        <TextView
                            style="@style/SettingsCategoryPanelTitle"
                            android:text="@string/settings_frequent_categories_panel_enabled"
                            android:textAlignment="viewStart" />

                        <ImageView
                            android:id="@+id/frequentCategoriesSettingsExpandIcon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_expand_add"
                            app:tint="@color/categoryTextSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/frequentCategoriesSettingsContent"
                        style="@style/SettingsCategoryPanelContent"
                        android:visibility="gone">

                        <View style="@style/SettingsCategoryPanelDivider" />

                        <LinearLayout
                            android:id="@+id/frequentCategoriesPanelRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_categories_panel_visible" />

                            <CheckBox
                                android:id="@+id/frequentCategoriesPanelCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_categories_panel_visible" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/frequentCategoriesLimitRow"
                            style="@style/SettingsValueRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_frequent_categories_limit" />

                            <TextView
                                android:id="@+id/frequentCategoriesLimitValue"
                                style="@style/SettingsNumericValueText" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/frequentCategoriesPanelTitleRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_frequent_categories_panel_show_title" />

                            <CheckBox
                                android:id="@+id/frequentCategoriesPanelTitleCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_frequent_categories_panel_show_title" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/frequentCategoriesLabelsRow"
                            style="@style/SettingsToggleRow">

                            <TextView
                                style="@style/SettingsValueLabel"
                                android:text="@string/settings_frequent_categories_show_labels" />

                            <CheckBox
                                android:id="@+id/frequentCategoriesLabelsCheckBox"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@string/settings_frequent_categories_show_labels" />
                        </LinearLayout>
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/journalBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/journalSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/settings_journal_section_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/journalCurrencyDisplayModeRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_journal_currency_display_title" />

                    <TextView
                        android:id="@+id/journalCurrencyDisplayModeValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/journalParentCategoryDisplayModeRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_journal_parent_category_display_title" />

                    <TextView
                        android:id="@+id/journalParentCategoryDisplayModeValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/journalDateSeparatorsRow"
                    style="@style/SettingsToggleRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_journal_show_date_separators" />

                    <CheckBox
                        android:id="@+id/journalDateSeparatorsCheckBox"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/settings_journal_show_date_separators" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/startupBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/startupSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/settings_start_fragment_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/startFragmentRow"
                    style="@style/SettingsValueRow">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/settings_start_fragment_value_title" />

                    <TextView
                        android:id="@+id/startFragmentValue"
                        style="@style/SettingsValueText" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/backupBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/backupSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/backup_section_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_half_normal"
                    android:text="@string/backup_section_description"
                    android:textColor="@color/categoryTextSecondary"
                    android:textSize="@dimen/H5" />

                <Button
                    android:id="@+id/createBackupButton"
                    style="@style/ButtonFullWidth"
                    android:layout_marginHorizontal="@dimen/margin_zero"
                    android:text="@string/backup_create_button" />

                <Button
                    android:id="@+id/restoreBackupButton"
                    style="@style/ButtonFullWidth"
                    android:layout_marginHorizontal="@dimen/margin_zero"
                    android:text="@string/backup_restore_button" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/aboutBlock"
                style="@style/SettingsSectionCard">

                <TextView
                    android:id="@+id/aboutSection"
                    style="@style/SettingsSectionTitle"
                    android:layout_marginLeft="@dimen/margin_zero"
                    android:text="@string/settings_about_section_title"
                    android:textColor="@color/inputText"
                    android:textSize="@dimen/H3"
                    android:textStyle="bold" />

                <LinearLayout
                    style="@style/SettingsValueRow"
                    android:clickable="false"
                    android:foreground="@null">

                    <TextView
                        style="@style/SettingsValueLabel"
                        android:text="@string/current_version" />

                    <TextView
                        android:id="@+id/appVersion"
                        style="@style/SettingsValueText"
                        android:hint="@string/current_version" />
                </LinearLayout>

                <Button
                    android:id="@+id/checkNewVersionButton"
                    style="@style/ButtonFullWidth"
                    android:layout_marginHorizontal="@dimen/margin_zero"
                    android:text="@string/text_on_button_check_update" />

                <Button
                    android:id="@+id/versionHistoryButton"
                    style="@style/ButtonFullWidth"
                    android:layout_marginHorizontal="@dimen/margin_zero"
                    android:text="@string/version_history_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
