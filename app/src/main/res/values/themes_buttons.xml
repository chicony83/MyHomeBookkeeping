<resources>

    <style name="Buttons" />

    <style name="ButtonsMatchParent_WrapContent" parent="Buttons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SelectedParamDescription">
        <item name="android:layout_marginStart">@dimen/margin_double</item>
        <item name="android:layout_width">200dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="SelectedParamName" parent="WrapContent_WrapContent">
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="DialogButtons" parent="Buttons">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/buttonNeutralText</item>
        <item name="android:background">@drawable/button_neutral_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingStart">@dimen/margin_double</item>
        <item name="android:paddingEnd">@dimen/margin_double</item>
        <item name="android:includeFontPadding">false</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:insetTop">@dimen/margin_zero</item>
        <item name="android:insetBottom">@dimen/margin_zero</item>
        <item name="android:layout_margin">@dimen/margin_normal</item>
    </style>

    <style name="TopButtons" parent="DialogButtons">
        <item name="android:background">@drawable/button_filter_background</item>
        <item name="android:textColor">@color/buttonNeutralText</item>
        <item name="android:textSize">@dimen/H6</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">@dimen/margin_double</item>
        <item name="android:paddingEnd">@dimen/margin_double</item>
    </style>

    <style name="ReportFilterButton" parent="TopButtons">
        <item name="android:textSize">@dimen/report_helper_text</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_second_color</item>
        <item name="android:layout_margin">@dimen/margin_zero</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">@dimen/margin_normal</item>
        <item name="android:paddingEnd">@dimen/margin_normal</item>
    </style>

    <style name="ReportCategoryActionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_margin">@dimen/margin_zero</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/buttonNeutralText</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">@dimen/margin_zero</item>
        <item name="android:paddingStart">@dimen/margin_normal</item>
        <item name="android:paddingEnd">@dimen/margin_normal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:insetTop">@dimen/margin_zero</item>
        <item name="android:insetBottom">@dimen/margin_zero</item>
        <item name="backgroundTint">@color/report_category_filter_button_background</item>
        <item name="strokeColor">@color/report_category_filter_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="elevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ReportCategoryActionButton.TopLeft">
        <item name="shapeAppearanceOverlay">@style/ShapeReportCategoryActionTopLeft</item>
    </style>

    <style name="ReportCategoryActionButton.TopCenter">
        <item name="shapeAppearanceOverlay">@style/ShapeReportCategoryActionTopCenter</item>
    </style>

    <style name="ReportCategoryActionButton.TopRight">
        <item name="shapeAppearanceOverlay">@style/ShapeReportCategoryActionTopRight</item>
    </style>

    <style name="ReportCategoryActionButton.BottomLeft">
        <item name="shapeAppearanceOverlay">@style/ShapeReportCategoryActionBottomLeft</item>
    </style>

    <style name="ReportCategoryActionButton.BottomRight">
        <item name="shapeAppearanceOverlay">@style/ShapeReportCategoryActionBottomRight</item>
    </style>

    <style name="DialogButtonLeft" parent="DialogButtons">

    </style>

    <style name="DialogButtonCenter" parent="DialogButtons">

    </style>

    <style name="DialogButtonRight" parent="DialogButtons">

    </style>

    <style name="ButtonFullWidth" parent="DialogButtons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ButtonFullWidth.AddAndSelect">
        <item name="android:text">@string/text_on_button_add_and_select</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/buttonPrimaryText</item>
    </style>

    <style name="DialogButtonLeft.Positive">
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/buttonPrimaryText</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogButton" parent="DialogButtons">
        <item name="android:layout_width">0dp</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogButtonRight.Negative">
        <item name="android:background">@drawable/button_neutral_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/buttonNeutralText</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogButtonCenter.Select">
        <item name="android:background">@drawable/button_primary_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/buttonPrimaryText</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:textStyle">normal</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogButtonLeft.Change">
        <item name="android:background">@drawable/button_neutral_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/colorPrimaryVariant</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="FastPaymentsTopButtons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
    <style name="FastPaymentsTopButtons.Left">
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
    </style>
</resources>
