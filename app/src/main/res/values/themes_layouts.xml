<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LinearLayoutWeightSum2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="DialogLayout.PositiveNegativeButtons" parent="MatchParent_WrapContent">
        <item name="android:orientation">horizontal</item>
        <item name="android:weightSum">2</item>
    </style>

    <style name="SettingsSectionCard" parent="MatchParent_WrapContent">
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
        <item name="android:layout_marginTop">@dimen/margin_half_normal</item>
        <item name="android:layout_marginEnd">@dimen/margin_normal</item>
        <item name="android:layout_marginBottom">@dimen/margin_half_normal</item>
        <item name="android:background">@drawable/category_group_background</item>
        <item name="android:elevation">1dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/margin_normal</item>
    </style>

    <style name="SettingsSectionTitle" parent="TextDescriptions">
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginLeft">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="SettingsValueRow" parent="MatchParent_WrapContent">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">@dimen/margin_quarter_of_normal</item>
        <item name="android:paddingBottom">@dimen/margin_quarter_of_normal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="SettingsToggleRow" parent="SettingsValueRow" />

    <style name="SettingsNestedBlockContent" parent="MatchParent_WrapContent">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/margin_normal</item>
        <item name="android:paddingEnd">@dimen/margin_normal</item>
        <item name="android:paddingBottom">@dimen/margin_half_normal</item>
    </style>

    <style name="SettingsDivider" parent="MatchParent_WrapContent">
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">@dimen/margin_half_normal</item>
        <item name="android:layout_marginBottom">@dimen/margin_half_normal</item>
        <item name="android:background">@color/categoryDivider</item>
    </style>

    <style name="SettingsValueLabel" parent="WrapContent_WrapContent">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/inputText</item>
        <item name="android:textSize">@dimen/H4</item>
    </style>

    <style name="SettingsValueText" parent="WrapContent_WrapContent">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/categoryTextSecondary</item>
        <item name="android:textSize">@dimen/H4</item>
    </style>

    <style name="SettingsNumericValueText" parent="SettingsValueText">
        <item name="android:layout_width">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
    </style>
</resources>
