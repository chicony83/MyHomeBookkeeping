<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Header">
        <item name="android:textSize">@dimen/H2</item>
        <item name="android:layout_marginTop">@dimen/margin_half_normal</item>
    </style>

    <style name="Description" parent="MatchParent_WrapContent">
        <item name="android:textSize">@dimen/H1</item>
        <item name="android:layout_marginTop">@dimen/margin_half_normal</item>
    </style>

    <style name="Description.ItemsSettings">
        <item name="android:textSize">@dimen/H3</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Description.first_launch_fragment">
        <item name="android:textSize">@dimen/H3</item>
        <item name="android:layout_margin">@dimen/margin_normal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Description.MessageOfBusyName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">@dimen/H5</item>
        <item name="android:textColor">@color/warning</item>
        <item name="android:visibility">gone</item>
        <item name="android:text">@string/description_this_name_is_taken</item>
    </style>

    <style name="Description.IncomeText">
        <item name="android:textColor">@color/incomeTextColor</item>
        <item name="android:textSize">@dimen/H4</item>
    </style>

    <style name="Description.IncomeText.FirstLaunch">
        <item name="android:checked">true</item>
    </style>

    <style name="Description.SpendingText">
        <item name="android:textColor">@color/spendingTextColor</item>
        <item name="android:textSize">@dimen/H4</item>

    </style>

    <style name="Description.SpendingText.FirstLaunch">
        <item name="android:checked">true</item>
    </style>

    <style name="Description.CashAccounts" />

    <style name="Description.CashAccounts.FirstLaunch">
        <item name="android:textSize">@dimen/H4</item>
        <item name="android:checked">true</item>
    </style>

    <style name="Description.Currencies" />

    <style name="Description.Currencies.FirstLaunch">
        <item name="android:textSize">@dimen/H4</item>
    </style>

    <style name="TextView" parent="WrapContent_WrapContent">

    </style>

    <style name="TextView.RecyclerViewHorizontalItem">
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
    </style>

    <style name="Description.LastVersion">
        <item name="android:textSize">@dimen/H4</item>
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
        <item name="android:layout_marginEnd">@dimen/margin_normal</item>
        <item name="android:layout_marginTop">@dimen/margin_normal</item>
        <item name="android:layout_marginBottom">@dimen/margin_normal</item>
    </style>

    <style name="Description.LastVersion.Header">
        <item name="android:textSize">@dimen/H1</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ReportTitleText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/report_title_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportTotalAmountText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/report_total_amount_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportSectionTitleText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/report_section_title_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportPrimaryText">
        <item name="android:textColor">@color/text_color</item>
        <item name="android:textSize">@dimen/report_primary_text</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ReportSecondaryText">
        <item name="android:textColor">@color/text_second_color</item>
        <item name="android:textSize">@dimen/report_secondary_text</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ReportHelperText">
        <item name="android:textColor">@color/text_second_color</item>
        <item name="android:textSize">@dimen/report_helper_text</item>
        <item name="android:textStyle">normal</item>
    </style>

</resources>
